rules_version = '2';

/*
 * FIRESTORE YA NO SE USA (desde la mudanza a Azure, septiembre de 2026).
 *
 * Firebase solo sirve para ENTRAR con Google (Firebase Auth). Los datos del curso
 * viven en Azure Table Storage y los atiende la API (api/src/functions). Por eso
 * aquí se niega todo: nadie lee ni escribe nada, con o sin sesión.
 *
 * Antes de cerrar se comprobó (17-oct-2026) que todo lo que quedaba aquí ya
 * estaba en Azure, salvo 16 puestos del ranking viejo «por día» (junio-julio)
 * que la mudanza dejó fuera a propósito (no dicen a qué lección corresponden).
 * Todo sigue en la copia semanal: Azure gembrespaldos/respaldos/AAAA-MM-DD/firebase/.
 * Las reglas anteriores están en el historial de git.
 */
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
