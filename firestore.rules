rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // Correos que SIEMPRE son admin (edítalos aquí si cambian).
    function adminEmails() {
      return [
        'fundacionsocial@gimnasioemocionalmb.com'
      ];
    }

    // Admin = correo verificado en la lista O rol 'admin' en su doc.
    // No requiere claves de servidor: se valida con el correo del login de Google.
    function isAdmin() {
      return isSignedIn() && (
        (
          request.auth.token.email_verified == true &&
          request.auth.token.email in adminEmails()
        ) ||
        (
          exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
        )
      );
    }

    // "Super admin" = el correo de la fundación. Es el ÚNICO que puede nombrar o
    // quitar administradores (cambiar el rol) y borrar cuentas.
    function isSuperAdmin() {
      return isSignedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email in adminEmails();
    }

    // --- USUARIOS ---
    match /users/{uid} {
      // Cada quien lee SOLO su propio perfil; el admin puede listar a todos.
      // (Protege los correos y teléfonos de las demás personas.)
      allow get: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      // Cada quien crea su propio perfil y SOLO como 'user'.
      // Nadie puede nacer siendo admin ni con el plan de pago.
      allow create: if isSignedIn()
                    && request.auth.uid == uid
                    && request.resource.data.role == 'user'
                    && request.resource.data.get('plan', 'ordinario') == 'ordinario';
      // Puedes editar tu propio perfil, pero NO tu rol. El admin sí puede.
      // Super admin: puede todo, incluido cambiar roles (nombrar/quitar admins).
      // Otros admins: gestionan personas pero NO pueden cambiar el rol.
      // Cada quien edita su propio perfil sin tocar su rol ni su inscripción.
      allow update: if isSuperAdmin()
                    || (isAdmin()
                        && request.resource.data.role == resource.data.role)
                    || (isSignedIn()
                        && request.auth.uid == uid
                        && request.resource.data.role == resource.data.role
                        // .get(): los perfiles más antiguos no tienen el campo
                        // y sin esto no podían ni editar sus propios datos.
                        && request.resource.data.get('enrolled', true) == resource.data.get('enrolled', true)
                        // La lectura en voz alta solo la activa/desactiva un admin.
                        && request.resource.data.get('voiceReader', false) == resource.data.get('voiceReader', false)
                        // El plan (pro / ordinario) SOLO lo cambia un admin:
                        // nadie puede darse acceso Pro a sí mismo.
                        && request.resource.data.get('plan', 'pro') == resource.data.get('plan', 'pro'));
      // Borrar cuentas: solo el super admin.
      allow delete: if isSuperAdmin();
    }

    // --- LECCIONES ---
    match /lessons/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // --- PROGRESO ---
    match /progress/{pid} {
      allow read: if isSignedIn()
                  && (isAdmin() || resource.data.userId == request.auth.uid);
      // Forma válida de un documento de avance (se usa al crear y al editar).
      // Los campos se validan SOLO si vienen: así se puede guardar únicamente
      // la nota del cuaderno en una lección que todavía no está marcada.
      function avanceValido() {
        return request.resource.data.userId == request.auth.uid
               && request.resource.data.keys().hasOnly(
                    ['userId', 'ciclo', 'lessonId', 'lessonNumber',
                     'completed', 'completedAt', 'nota', 'notaEn'])
               && request.resource.data.lessonNumber is int
               && request.resource.data.lessonNumber >= 1
               && request.resource.data.lessonNumber <= 400
               && (!request.resource.data.keys().hasAny(['nota'])
                   || (request.resource.data.nota is string
                       && request.resource.data.nota.size() <= 1000))
               && (!request.resource.data.keys().hasAny(['completed'])
                   || request.resource.data.completed is bool)
               && (!request.resource.data.keys().hasAny(['lessonId'])
                   || request.resource.data.lessonId is string)
               && (!request.resource.data.keys().hasAny(['ciclo'])
                   || request.resource.data.ciclo is string)
               && (!request.resource.data.keys().hasAny(['notaEn'])
                   || request.resource.data.notaEn is int)
               && (!request.resource.data.keys().hasAny(['completedAt'])
                   || request.resource.data.completedAt == null
                   || request.resource.data.completedAt is int);
      }
      allow create: if isSignedIn() && avanceValido();
      // CLAVE: al editar hay que ser YA el dueño y no se puede cambiar de dueño.
      // Sin esto, cualquiera podía adueñarse del avance de otra persona (el id
      // es predecible) y leer su cuaderno privado.
      allow update: if isSignedIn()
                  && resource.data.userId == request.auth.uid
                  && request.resource.data.userId == resource.data.userId
                  && avanceValido();
      allow delete: if isAdmin()
                  || (isSignedIn() && resource.data.userId == request.auth.uid);
    }

    // --- FORO ---
    match /forumPosts/{pid} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.status == 'visible'
                    && request.resource.data.keys().hasOnly(
                         ['lessonNumber', 'userId', 'userName', 'userPhoto', 'message', 'createdAt', 'parentId', 'status'])
                    && request.resource.data.message is string
                    && request.resource.data.message.size() > 0
                    && request.resource.data.message.size() <= 5000
                    && request.resource.data.lessonNumber is int
                    && request.resource.data.createdAt is int
                    && request.resource.data.userName is string
                    && request.resource.data.userName.size() <= 120
                    && (request.resource.data.userPhoto == null
                        || request.resource.data.userPhoto is string)
                    && (request.resource.data.parentId == null
                        || request.resource.data.parentId is string);
      // El autor puede editar/borrar lo suyo (sin cambiar de dueño); el admin todo.
      // El autor edita SU mensaje, pero no puede deshacer la moderación del
      // admin ni cambiar de dueño, ni saltarse el límite de tamaño.
      allow update: if isAdmin()
                    || (isSignedIn()
                        && resource.data.userId == request.auth.uid
                        && request.resource.data.userId == resource.data.userId
                        && request.resource.data.status == resource.data.status
                        && request.resource.data.keys().hasOnly(
                             ['lessonNumber', 'userId', 'userName', 'userPhoto',
                              'message', 'createdAt', 'parentId', 'status'])
                        && request.resource.data.message is string
                        && request.resource.data.message.size() > 0
                        && request.resource.data.message.size() <= 5000);
      allow delete: if isAdmin();
    }

    // --- AJUSTES (solo admin escribe) ---
    match /adminSettings/{doc} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // --- CONFIGURACIÓN DEL CURSO ---
    // Guarda el "ciclo" (el año que se está corriendo): 2026, 2027…
    // Todos necesitan leerlo para que su avance quede en el año correcto,
    // pero SOLO un admin puede cambiarlo (cambiarlo reinicia el proceso).
    match /config/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // --- HISTORIAL DE AÑOS (resúmenes de años cerrados; solo admin, contiene datos) ---
    match /cohorts/{id} {
      allow read, write: if isAdmin();
    }

    // --- RANKING DIARIO (hora en que cada persona hizo su lección) ---
    // Lectura para personas con sesión (para contar el puesto y para el admin).
    // Cada quien solo puede crear su propio registro; editar/borrar solo admin.
    match /dailyDone/{id} {
      allow read: if isSignedIn();
      // El id SIEMPRE termina en el uid de la persona ("93_uid" o "2027_93_uid").
      // Sin esa comprobación, alguien podía crear el registro de OTRA persona
      // antes que ella y dejarle el puesto congelado para siempre.
      allow create: if isSignedIn()
                    && request.resource.data.uid == request.auth.uid
                    && id.matches('.*_' + request.auth.uid)
                    && request.resource.data.keys().hasOnly(
                         ['uid', 'ciclo', 'name', 'date', 'completedAt',
                          'position', 'lessonNumber'])
                    && request.resource.data.lessonNumber is int
                    && request.resource.data.lessonNumber >= 1
                    && request.resource.data.lessonNumber <= 400
                    && request.resource.data.position is int
                    && request.resource.data.completedAt is int;
      allow update, delete: if isAdmin();
    }
  }
}
