<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- La pantalla nativa de ajustes: oscura, con los colores del curso. -->
    <style name="Tema.Ajustes" parent="@android:style/Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@color/fondo</item>
        <item name="android:statusBarColor">@color/fondo</item>
        <item name="android:navigationBarColor">@color/fondo</item>
        <item name="android:colorAccent">#C49A52</item>
    </style>

    <!-- Base de los estilos «Ajustes.*» (Android hereda por el nombre con punto). -->
    <style name="Ajustes" />

    <style name="Ajustes.Seccion">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">20dp</item>
        <item name="android:background">@drawable/tarjeta</item>
        <item name="android:orientation">vertical</item>
        <item name="android:padding">18dp</item>
    </style>

    <style name="Ajustes.Titulo">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">#C49A52</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.12</item>
    </style>

    <style name="Ajustes.Texto">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:textColor">#C9C4B8</item>
        <item name="android:textSize">15sp</item>
        <item name="android:lineSpacingMultiplier">1.15</item>
    </style>

    <style name="Ajustes.Boton">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">52dp</item>
        <item name="android:layout_marginTop">12dp</item>
        <item name="android:background">@drawable/boton_borde</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">#F3EEE2</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="Ajustes.Boton.Principal">
        <item name="android:background">@drawable/boton_principal</item>
        <item name="android:textColor">#102A24</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>
