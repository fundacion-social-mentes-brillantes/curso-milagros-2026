<?xml version="1.0" encoding="utf-8"?>
<!-- Widget «Lección de hoy»: el verde casi negro del curso, el número en serif
     dorada (como en la web) y la idea del día. Todo el cuadro abre la lección. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_raiz"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_fondo"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:letterSpacing="0.12"
            android:text="LECCIÓN DE HOY"
            android:textColor="#C49A52"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/w_hecha"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="✓ Hecha"
            android:textColor="#7FD1B9"
            android:textSize="11sp"
            android:visibility="gone" />
    </LinearLayout>

    <TextView
        android:id="@+id/w_numero"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:fontFamily="serif"
        android:includeFontPadding="false"
        android:textColor="#F3EEE2"
        android:textSize="42sp" />

    <TextView
        android:id="@+id/w_idea"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="4dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="4"
        android:textColor="#E6E1D5"
        android:textSize="14sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Un Curso de Milagros"
        android:textColor="#8FA59E"
        android:textSize="10sp" />
</LinearLayout>
