<?xml version="1.0" encoding="utf-8"?>
<!-- Un Curso de Milagros para Android: abre https://cursodemilagros.gimnasioemocionalmb.com a
     pantalla completa en Chrome (Trusted Web Activity). Toda la app es la web, asi que se
     actualiza sola cuando cambia el sitio. Lo unico nativo (desde la version 1.1.0) es lo
     que tiene que funcionar aunque nadie abra la app: el recordatorio diario a la hora exacta
     y el widget «Leccion de hoy», con su pantalla de ajustes (AjustesActivity). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- El aviso del recordatorio (Android 13+ lo pregunta). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Que el recordatorio llegue a la hora exacta (Android 12+ lo pide aparte). -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- Volver a poner las alarmas despues de reiniciar el celular. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Para encontrar Chrome (u otro navegador compatible) y abrir la web adentro. -->
    <queries>
        <intent>
            <action android:name="android.support.customtabs.action.CustomTabsService" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:manageSpaceActivity="com.google.androidbrowserhelper.trusted.ManageDataLauncherActivity"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Translucent.NoTitleBar">

        <!-- La web del curso es de la misma fundacion (Chrome lo comprueba con assetlinks.json). -->
        <meta-data
            android:name="asset_statements"
            android:resource="@string/asset_statements" />

        <activity
            android:name="com.google.androidbrowserhelper.trusted.LauncherActivity"
            android:exported="true"
            android:label="@string/app_name">
            <meta-data
                android:name="android.support.customtabs.trusted.DEFAULT_URL"
                android:value="@string/url_inicio" />
            <meta-data
                android:name="android.support.customtabs.trusted.STATUS_BAR_COLOR"
                android:resource="@color/fondo" />
            <meta-data
                android:name="android.support.customtabs.trusted.NAVIGATION_BAR_COLOR"
                android:resource="@color/fondo" />
            <meta-data
                android:name="android.support.customtabs.trusted.NAVIGATION_BAR_DIVIDER_COLOR"
                android:resource="@color/fondo" />
            <!-- Mientras abre la web: el icono UCDM sobre el verde oscuro del curso. -->
            <meta-data
                android:name="android.support.customtabs.trusted.SPLASH_IMAGE_DRAWABLE"
                android:resource="@drawable/inicio" />
            <meta-data
                android:name="android.support.customtabs.trusted.SPLASH_SCREEN_BACKGROUND_COLOR"
                android:resource="@color/fondo" />
            <meta-data
                android:name="android.support.customtabs.trusted.SPLASH_SCREEN_FADE_OUT_DURATION"
                android:value="300" />
            <meta-data
                android:name="android.support.customtabs.trusted.FILE_PROVIDER_AUTHORITY"
                android:value="@string/proveedor" />
            <!-- Sin SCREEN_ORIENTATION a proposito (KITS va fija en vertical): aqui el video
                 de la leccion tiene que poder girar a horizontal, como en la web. -->
            <!-- Sin Chrome compatible se abre en una pestaña normal (nunca en WebView:
                 Google no deja entrar con la cuenta desde un WebView). -->
            <meta-data
                android:name="android.support.customtabs.trusted.FALLBACK_STRATEGY"
                android:value="customtabs" />

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Al dejar presionado el icono: «Hora del recordatorio». -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/atajos" />
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="cursodemilagros.gimnasioemocionalmb.com" />
            </intent-filter>
        </activity>

        <!-- «Administrar almacenamiento» en los ajustes de Android abre los datos del sitio en Chrome. -->
        <activity
            android:name="com.google.androidbrowserhelper.trusted.ManageDataLauncherActivity"
            android:exported="false">
            <meta-data
                android:name="android.support.customtabs.trusted.MANAGE_SPACE_URL"
                android:value="@string/url_inicio" />
        </activity>

        <!-- Le pasa a Chrome la imagen de la pantalla de carga. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="@string/proveedor"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/rutas" />
        </provider>

        <activity
            android:name="com.google.androidbrowserhelper.trusted.FocusActivity"
            android:exported="false" />

        <!-- «Recordatorio y widget». La web la abre con intent://ajustes?codigo=…
             (src/lib/app-android.ts) para vincular el celular con la cuenta. -->
        <activity
            android:name=".AjustesActivity"
            android:exported="true"
            android:label="Recordatorio y widget"
            android:launchMode="singleTop"
            android:theme="@style/Tema.Ajustes">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="ucdmcurso" android:host="ajustes" />
            </intent-filter>
        </activity>

        <receiver android:name=".RecordatorioReceiver" android:exported="false" />
        <receiver android:name=".MedianocheReceiver" android:exported="false" />
        <receiver android:name=".ArranqueReceiver" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>

        <!-- Widget «Leccion de hoy». -->
        <receiver
            android:name=".LeccionWidget"
            android:exported="false"
            android:label="@string/widget_nombre">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_leccion_info" />
        </receiver>
    </application>
</manifest>
